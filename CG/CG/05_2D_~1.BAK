#include <graphics.h>
#include <conio.h>
#include <stdio.h>

int main() {
    /* Initialize graphics mode */
    int gd = DETECT, gm;
    int tx = 100, ty = 50; /* Translation factors */
    int x1 = 50, y1 = 50, x2 = 150, y2 = 100;

    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");

    /* Draw original rectangle */
    setcolor(WHITE);
    rectangle(x1, y1, x2, y2);
    outtextxy(x1, y1 - 15, "Original");

    /* Perform Translation */
    x1 = x1 + tx;
    y1 = y1 + ty;
    x2 = x2 + tx;
    y2 = y2 + ty;

    /* Draw translated rectangle */
    setcolor(YELLOW);
    rectangle(x1, y1, x2, y2);
    outtextxy(x1, y1 - 15, "Translated");

    getch();
    closegraph();
    return 0;
}