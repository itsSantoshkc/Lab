@{
    ViewData["Title"] = "Todo ";
}

<h2>Todo Form</h2>

<form asp-action="AddTodo" method="post">
    
    <label>Title:</label>
    <input type="text"  name="title" placeholder="Enter the Todo Title" />
    

    <br /><br />

    <button type="submit">Add Todo</button>
</form>

@if (ViewBag.Interest != null)
{
    <h3>Simple Interest = @ViewBag.Interest</h3>
}